{
  "name": "@exitliquidity/ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swap ingest: Yellowstone gRPC stream, RPC backfill worker, normalisation pipeline and CLI.",
  "main": "./dist/index.js",
  "bin": {
    "exitliquidity": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "cli": "tsx src/cli.ts",
    "dev:stream": "tsx watch src/cli.ts stream"
  },
  "dependencies": {
    "@clickhouse/client": "^1.12.1",
    "@exitliquidity/clickhouse": "workspace:*",
    "@exitliquidity/core": "workspace:*",
    "@exitliquidity/parsers": "workspace:*",
    "@exitliquidity/pricing": "workspace:*",
    "@exitliquidity/solana": "workspace:*",
    "@grpc/grpc-js": "^1.14.4",
    "@triton-one/yellowstone-grpc": "^1.3.0",
    "bs58": "^6.0.0",
    "bullmq": "^5.63.0",
    "ioredis": "^5.9.0"
  }
}
