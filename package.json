{
  "name": "exitliquidity",
  "version": "0.1.0",
  "private": true,
  "description": "ExitLiquidity — Solana counterparty forensics. P0: swap ingest.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --sequential run build",
    "prepare": "pnpm run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "migrate": "pnpm --filter @exitliquidity/ingest run cli migrate",
    "stream": "pnpm --filter @exitliquidity/ingest run cli stream",
    "backfill": "pnpm --filter @exitliquidity/ingest run cli backfill",
    "verify": "pnpm --filter @exitliquidity/ingest run cli verify-count",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
