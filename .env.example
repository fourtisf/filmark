# Copy to .env and fill in. Every value below is the default unless noted.

# ── logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Human-readable output for local runs; leave false in production.
LOG_PRETTY=false

# ── ClickHouse: the swap store ────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=exitliquidity
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Rows buffered before an insert is forced. ClickHouse wants few large inserts.
CLICKHOUSE_MAX_INSERT_ROWS=5000
CLICKHOUSE_MAX_INSERT_DELAY_MS=2000

# ── Redis: BullMQ backfill queue ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Yellowstone gRPC: the live stream ─────────────────────────────────────
# Required by `stream`. Triton and Helius both work; the x-token is the
# provider's API key. Examples:
#   Triton  https://<region>.rpcpool.com
#   Helius  https://<region>.helius-rpc.com
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_X_TOKEN=
YELLOWSTONE_COMMITMENT=confirmed
YELLOWSTONE_IDLE_TIMEOUT_MS=30000
YELLOWSTONE_PING_INTERVAL_MS=10000
YELLOWSTONE_RECONNECT_MIN_MS=500
YELLOWSTONE_RECONNECT_MAX_MS=30000

# ── JSON-RPC: backfill, mint lookups and every wallet trace ───────────────
# Required by `backfill`, `worker`, `dump-tx` and the whole trace API. Needs
# history as deep as TRACE_LOOKBACK_DAYS; a default public endpoint will not
# have it, and will rate-limit a trace to a standstill. Helius:
#   https://mainnet.helius-rpc.com/?api-key=<YOUR KEY>
# This value is a credential. It never leaves the server: the console is a
# static page that calls the API below, and the API calls this.
#
# Several may be given, comma separated, and usually should be. A rate limit
# belongs to a key, so the allowances add up rather than compete — and a key
# that exhausts its monthly credit mid-crawl takes its own traffic down instead
# of the whole service. The client spreads work across whichever endpoint can
# take it soonest, sets a refused one aside, and comes back to it later.
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=A,https://other/?key=B
# Every endpoint must serve `getSignaturesForAddress` as deep as
# TRACE_LOOKBACK_DAYS; a pruning endpoint silently shortens the window.
SOLANA_RPC_URL=
# Client-side rate limit, so a backfill cannot exhaust a shared key. Set it to
# what your plan actually allows: everything below is derived from it.
SOLANA_RPC_MAX_RPS=10
# Transactions per JSON-RPC batch request. 1 disables batching.
# Clamped to SOLANA_RPC_MAX_RPS at startup, and that clamp matters: a batch is
# one HTTP request but N metered calls, all landing in the same millisecond. A
# batch wider than the per-second allowance is refused on arrival no matter how
# patiently the client spaced it — every attempt comes back 429, which reads as
# a dead key rather than as a batch that was too wide.
SOLANA_RPC_BATCH_SIZE=20
SOLANA_RPC_MAX_ATTEMPTS=5
SOLANA_RPC_TIMEOUT_MS=20000

# ── Pyth: SOL/USD, never priced off the pool (spec §2 Stage 1) ────────────
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_BENCHMARKS_URL=https://benchmarks.pyth.network
PYTH_SOL_USD_FEED_ID=ef0d8b6fda2ceba41da15d4095d1da392a0d2f8ed0c6c7bc0f4cfac8c280b56d
# Requests a second to Benchmarks. It is free, keyless and shared with everyone
# else pointed at it, and a range of any size arrives as a series of 5,000-bar
# windows — 106 of them for a year. Fired unthrottled they come back 429 and
# take the run with them. The client also halves this on a refusal and eases
# back on success, so this is a ceiling rather than a promise.
PYTH_MAX_RPS=3
# How far a swap may sit from the nearest SOL/USD minute before it is left
# unpriced rather than priced badly.
PRICE_MAX_STALENESS_SEC=300

# ── Backfill ──────────────────────────────────────────────────────────────
BACKFILL_CONCURRENCY=4
BACKFILL_DEFAULT_DAYS=90
BACKFILL_SIGNATURE_PAGE_SIZE=1000
BACKFILL_TRANSACTION_BATCH=20

# ── Trace API (apps/api) — what the console talks to ──────────────────────
API_HOST=0.0.0.0
API_PORT=8080
# Browser origins allowed to call this, comma separated. Empty means none, so
# the console will not reach it until this is set. `*` lets any page on the
# internet spend your RPC key; only use it behind your own rate limiting.
#   API_CORS_ORIGINS=https://fillmark.xyz,https://www.fillmark.xyz
API_CORS_ORIGINS=
# A completed trace is served from memory for this long before it is recomputed.
API_CACHE_TTL_SEC=300
API_CACHE_MAX_ENTRIES=200
# Traces computed at once. Each is a long series of RPC calls; raising this
# multiplies RPC spend, it does not make an individual trace faster.
API_MAX_CONCURRENT_TRACES=2
# The wall clock a trace gets. The crawls stop at 90% of this and answer with
# what they read, marked `stoppedOnTimeBudget`; the hard abort behind them is
# what returns 504, and reaching it means no answer at all.
#
# If anything proxies this service, set this BELOW that proxy's own response
# timeout — Cloudflare's is 100s and is not configurable below Enterprise. Past
# it the proxy answers with an HTML error page instead of the trace, which the
# console can only report as "something in front of the engine answered".
API_TRACE_TIMEOUT_MS=180000
# Answer a trace from the ClickHouse swap index when a backfill has covered the
# wallet, instead of crawling the chain. Off by default, because an API pointed
# at a ClickHouse that is not running would fail on a dependency the live path
# never needed. On, `coverage.source` says which of the two answered, and a
# wallet no backfill has covered still falls through to the crawl.
#   pnpm migrate
#   pnpm --filter @exitliquidity/ingest exec tsx src/cli.ts backfill <WALLET> --days 365
API_USE_INDEX=false

# ── Trace budgets — the cost of one wallet ────────────────────────────────
# Every limit here has a matching field in the response, so a trace that runs
# out of budget says so rather than presenting a partial read as a whole one.
TRACE_LOOKBACK_DAYS=90
# Signatures read for the traced wallet before the crawl is cut short. Each one
# costs a getTransaction, so this dominates what a trace spends: at 10 calls per
# second, 1200 is about two minutes. Keep API_TRACE_TIMEOUT_MS above it.
TRACE_MAX_SIGNATURES=1200
# Losing positions attributed per trace, largest loss first.
TRACE_MAX_POSITIONS=12
# Buy legs netted per position, largest cost basis first.
TRACE_MAX_LEGS_PER_POSITION=6
# Signature pages crawled for window netting across the WHOLE trace, shared by
# every pool rather than granted per pool. 1000 signatures each.
TRACE_MAX_POOL_SIGNATURE_PAGES=20
# Pool transactions fetched for window netting, across the whole trace.
TRACE_MAX_POOL_TRANSACTIONS=600

# ── Observability ─────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9464

# Drops swaps below this USD size. 0 keeps everything, which is what the P0
# acceptance test needs — a size filter would make the count fail by design.
MIN_SWAP_USD=0
